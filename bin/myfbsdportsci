#!/bin/sh

set -euo pipefail

err() {
  >&2 printf 'ERROR: %s.\nUsage: myfbsdportsci <forgejo runner workspace> <base ref> <head ref>\n' "$1"
  exit 1
}

tap() {
  result="$1"; shift # either 'ok' or 'not ok'
  msg="$(printf "$@")"
  printf '%s %d - %s: %s\n' \
    "${result}" "${test_num}" "${origin}" "${msg}" \
    >> "${summary}"
}

ci() {
  origin="$1"

  logs="${workspace}/ports_ci_results/${origin}"
  mkdir -p "${logs}"

  test_depends_origins="$(make -C "${portsdir}/${origin}" -V TEST_DEPENDS | awk -v 'RS=[ \t]*' -v 'ORS= ' -F: '{ print $2 }')"
  test_depends_bulk_log="poudriere_bulk_test_depends.log"
  if ! mdo poudriere bulk -j "${jail}" ${test_depends_origins} 2>&1 | tee "${logs}/${test_depends_bulk_log}"; then
    tap 'not ok' 'ERROR: `poudriere bulk` of TEST_DEPENDS failed. Log: %s' "${test_depends_bulk_log}"
    return 1
  fi

  testport_log="poudriere_testport.log"
  if ! mdo poudriere testport -NNI -j "${jail}" "${origin}" 2>&1 | tee "${logs}/${testport_log}"; then
    tap 'not ok' 'ERROR: `poudriere testport` failed. Log: %s' "${testport_log}"
    return 1
  fi

  test_depends_install_log="jail_test_depends_install.log"
  if ! mdo jexec "${jail}-default-n" pkg install -y ${test_depends_origins} 2>&1 | tee "${logs}/${test_depends_install_log}"; then
    tap 'not ok' 'CRITICAL: failed to install TEST_DEPENDS. Log: %s' "${test_depends_install_log}"
    return 1
  fi

  make_test_log="make_test.log"
  set +e
  mdo jexec -U nobody "${jail}-default-n" timeout -k 30s "${test_timeout}" make -C "/usr/ports/${origin}" test 2>&1 | tee "${logs}/${make_test_log}"
  rc=$?
  set -e
  if [ "${rc}" -eq 124 ]; then
    tap 'not ok' 'CRITICAL: `make test` timed out after %s. Log: %s and report to MAINTAINER.' "${test_timeout}" "${make_test_log}"
    return 1
  elif [ "${rc}" -ne 0 ]; then
    tap 'not ok' 'WARNING: `make test` failed. Log: %s' "${make_test_log}"
    return 2
  fi

  tap ok 'all tests passed'
}

while getopts j:p:t: name
do
  case "${name}" in
    j) jail="${OPTARG}" ;;
    p) portsdir="${OPTARG}" ;;
    t) test_timeout="${OPTARG}" ;;
    ?) err "Unknown flag '${name}'" ;;
    *) ;;
  esac
done
shift $((OPTIND - 1))
: "${jail:=151amd64}"
: "${portsdir:=/usr/ports}"
: "${test_timeout:=5m}"

[ $# -eq 3 ]                   || err "wrong number of arguments"
timeout "${test_timeout}" true || err "Bad argument: -t ${test_timeout}: incorrect format"
[ -d "${portsdir}" ]           || err "Bad argument: -p ${portsdir}: ports tree doesn't exist"
mdo id -u | xargs test 0 -eq   || err "Permission denied: mdo(1) not configured"

# from any incoming pull request, we will only get:
# head ref (source branch)
# base ref (target branch)
workspace="$1"
baseref="$2"
headref="$3"
summary="${workspace}/ports_ci_results/summary.tap"

git -C "${portsdir}" fetch origin "${baseref}" "${headref}"
maybe_origins="$(git -C "${portsdir}" diff --name-only "origin/${headref}..origin/${baseref}" | awk -F/ -vOFS=/ '{ print $1, $2 }' | sort -u)"

all_origins=
num_origins=0
while IFS= read -r origin; do
  if [ -r "${origin}/Makefile" ]; then
    all_origins="${all_origins} ${origin}"
    num_origins=$(( num_origins + 1))
  fi
done <<EOF
${maybe_origins}
EOF

git -C "${portsdir}" switch -d "${headref}"
mdo poudriere jail -k -j "${jail}" || true
printf 'TAP version 14\n1..%d\n' "${num_origins}" > "${summary}"

test_num=1
for origin in ${all_origins}; do
  # Ignore the exit code here. We will simply grep for 'not ok' in the
  # TAP test results to determine the overall result.
  ci "${origin}" || true
  mdo poudriere jail -k -j "${jail}" || true
  test_num=$(( test_num + 1 ))
done

tar --zstd -C "${workspace}" -cvf ports_ci_results.tar.zst ports_ci_results
printf '\n########## RESULTS ##########\n\n'
cat "${summary}"
printf '\n#############################\n'
! grep -q '^not ok' "${summary}"
