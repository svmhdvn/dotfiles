#!/bin/sh

set -u

threshold=25
bat="$(cat /sys/class/power_supply/BAT0/capacity)"
cap="$(cat /sys/class/power_supply/BAT0/status)"
date="$(date '+%a %F | %H:%M')"

u=low
[ "${threshold}" -gt "${bat}"] && u=urgent
[ "${cap}" = Discharging ] || u=normal

fyi \
  --app-name mywstatus \
  --urgency "${u}" \
  --hint "int:value:${bat}" \
  --hint string:x-canonical-private-synchronous:battery \
  --expire-time 5000 \
"${date}" "battery ${bat}% (${cap})"
