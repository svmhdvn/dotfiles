#!/bin/sh

set -u

threshold=25
bat="$(cat /sys/class/power_supply/BAT0/capacity)"
cap="$(cat /sys/class/power_supply/BAT0/status)"
date="$(date '+%a %F | %H:%M')"

battery_fmt='battery %s%% (%s)'

if test "${cap}" = Discharging -a "${threshold}" -gt "${bat}"; then
  battery_fmt="<span background='red' text_transform='uppercase' size='xx-large'><b>${battery_fmt}</b></span>"
fi

printf "%s | ${battery_fmt} \n" "${date}" "${bat}" "${cap}"
