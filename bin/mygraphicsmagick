#!/bin/sh

set -eu

# Builds a 10-page B7 pocket notebook imposed 2x2 on three US Letter sheets
#
# Layout:
#   Sheet 1: p1 (photo1), p2, p3, p4
#   Sheet 2: p5, p6, p7, p8 (photo8)
#   Sheet 3: p9 (photo9), p10 (photo10), blank, blank

# TODO allow any page size

#### B7 SIZE ####
DPI=300
xpx=1039 # (DPI / mm_per_in) x width=88mm
ypx=1476 # (DPI / mm_per_in) x height=125mm
#### B7 SIZE ####

LETTER_W=2550
LETTER_H=3300
blurscale=8

dither_resize() {
  gm convert "$1" \
    -gravity center \
    -resize "${xpx}x${ypx}^" \
    -extent "${xpx}x${ypx}" \
    +repage \
    -normalize \
    -modulate 125,0 \
    -resize "$(( xpx / blurscale ))x$(( ypx / blurscale ))" \
    -ordered-dither Intensity 4x4 \
    -sample "${xpx}x${ypx}" \
    -type TrueColor \
    -fill '#aaaaaa' -opaque black -colorspace Gray \
    -set units PixelsPerInch \
    -density "${DPI}" \
    "$2"
}

dither_resize "$1" photo1.png
dither_resize "$2" photo8.png
dither_resize "$3" photo9.png
dither_resize "$4" photo10.png

# blank B7 page
gm convert -size "${xpx}x${ypx}" -compress Zip xc:white blank.tif

# build each sheet as a 2x2 grid of B7 pages
gm montage -tile 2x2 -geometry "${xpx}x${ypx}+0+0" -background white -compress Zip \
    photo1.png blank.tif blank.tif blank.tif page1.tif
gm montage -tile 2x2 -geometry "${xpx}x${ypx}+0+0" -background white -compress Zip \
    blank.tif blank.tif blank.tif photo8.png page2.tif
gm montage -tile 2x2 -geometry "${xpx}x${ypx}+0+0" -background white -compress Zip \
    photo9.png photo10.png blank.tif blank.tif page3.tif

# pad each sheet to US Letter
for n in 1 2 3; do
    gm convert "page${n}.tif" -gravity center -background white \
        -extent "${LETTER_W}x${LETTER_H}" \
        -units PixelsPerInch -density "${DPI}" \
        -depth 8 \
        -compress Zip \
        "sheet${n}.tif"
done

# combine into a Letter PDF
tiffcp sheet*.tif allsheets.tif
tiff2pdf -z -p letter -o notebook.pdf allsheets.tif
pdfinfo notebook.pdf
